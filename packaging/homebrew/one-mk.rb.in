# Homebrew cask for one-mk (UNTESTED: written without a Mac).
# `sh scripts/package-homebrew.sh` fills in the version and the checksums of
# the two .dmg files the release publishes (made by scripts/bundle-mac.sh).
# Put the result in a tap, e.g. samer2373/homebrew-tap/Casks/one-mk.rb:
#   brew install --cask samer2373/tap/one-mk
cask "one-mk" do
  arch arm: "aarch64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM64@",
         intel: "@SHA256_X64@"

  url "https://github.com/samer2373/one-mk/releases/download/v#{version}/one-mk-#{arch}-apple-darwin.dmg"
  name "one·mk"
  desc "Share one mouse and keyboard between computers"
  homepage "https://github.com/samer2373/one-mk"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :big_sur"

  app "one-mk.app"
  # `one-mk pair`, `one-mk send` and the rest from the terminal.
  binary "#{appdir}/one-mk.app/Contents/MacOS/one-mk"

  uninstall launchctl: ["com.one-mk.daemon", "com.one-mk.tray"],
            quit:      "com.one-mk.app"

  zap trash: [
    "~/Library/Application Support/one-mk",
    "~/Library/LaunchAgents/com.one-mk.daemon.plist",
    "~/Library/LaunchAgents/com.one-mk.tray.plist",
    "~/Library/Logs/one-mk*.log",
  ]

  caveats <<~EOS
    Open one·mk from Applications, click Start and turn on "Start at login"
    in the window. macOS asks for Accessibility permission the first time:
    turn on one·mk in System Settings > Privacy & Security > Accessibility.
  EOS
end
