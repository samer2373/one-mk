# Homebrew cask for one-mk (UNTESTED: written without a Mac).
# `sh scripts/package-homebrew.sh` fills in the version and checksums from
# the release's .dmg files. Put the result in a tap, e.g. samer2373/homebrew-tap/Casks/one-mk.rb:
#   brew install --cask samer2373/tap/one-mk
cask "one-mk" do
  arch arm: "arm64", intel: "x64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM64@",
         intel: "@SHA256_X64@"

  url "https://github.com/samer2373/one-mk/releases/download/v#{version}/one-mk-#{version}-#{arch}.dmg"
  name "one-mk"
  desc "Share one mouse and keyboard between computers"
  homepage "https://github.com/samer2373/one-mk"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :big_sur"

  app "one-mk.app"
  # `one-mk pair`, `one-mk send` and the rest from the terminal.
  binary "#{appdir}/one-mk.app/Contents/MacOS/one-mk"

  uninstall launchctl: ["com.one-mk.daemon", "com.one-mk.tray"],
            quit:      "com.one-mk.app"

  zap trash: [
    "~/Library/Application Support/one-mk",
    "~/Library/LaunchAgents/com.one-mk.daemon.plist",
    "~/Library/LaunchAgents/com.one-mk.tray.plist",
    "~/Library/Logs/one-mk*.log",
  ]

  caveats <<~EOS
    one-mk is not notarised yet. If macOS says it cannot be opened, allow it in
    System Settings > Privacy & Security, or run:
      xattr -dr com.apple.quarantine "#{appdir}/one-mk.app"
    Then grant Accessibility and Input Monitoring when asked, and run
      one-mk install
    to start it at login.
  EOS
end
